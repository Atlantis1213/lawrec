#!/bin/sh
APP=/app/lawrec/ui/ui
PID=/var/run/lawrec-ui.pid
LOG=/tmp/lawrec.log
start() {
    [ -f /etc/lawrec-ui.autostart ] || return 0
    [ -x "$APP" ] || return 1
    if pidof ui >/dev/null 2>&1; then return 0; fi
    mkdir -p /var/run
    i=0
    while [ ! -e /dev/dri/card0 ] && [ "$i" -lt 100 ]; do
        sleep 0.2
        i=$((i+1))
    done
    [ -e /dev/dri/card0 ] || return 1
    start-stop-daemon -S -b -m -p "$PID" -x "$APP" >>"$LOG" 2>&1
}
stop() {
    killall ui 2>/dev/null || true
    i=0
    while pidof ui >/dev/null 2>&1; do
        [ "$i" -lt 15 ] || { echo 'lawrec stop timeout; inspect log'; return 1; }
        sleep 1
        i=$((i+1))
    done
    rm -f "$PID"
}
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
